# =====================================================================
# SignaLex V10 - environment variable declarations
# This file is committed to GitHub: NAMES AND SAFE DEFAULTS ONLY.
# Put the real secret values in AI Studio's Secrets panel (or in
# .env.local / po-gateway/.env locally). Never write them in this file.
# Leave a secret EMPTY here rather than using placeholder text.
# =====================================================================

# --- Shared secret between Next.js, python-backend and po-gateway ----
# Must be identical everywhere. Generate your own 64-hex-char value.
INTERNAL_API_TOKEN=CHANGE_ME

# --- Service addresses ------------------------------------------------
PYTHON_BACKEND_URL=http://127.0.0.1:8001
PYTHON_BACKEND_PORT=8001
PO_GATEWAY_URL=http://127.0.0.1:8002
NEXTAUTH_URL=http://127.0.0.1:3000

# --- Pocket Option gateway (DEMO) -------------------------------------
# PO_SESSION / PO_UID come from the browser's trading-socket "auth"
# message. They expire; re-extract them when the gateway reports it.
PO_SESSION=""
PO_UID=""
PO_REGION=DEMO
PO_USE_FAKE_ADAPTER=false

# --- Gateway safety caps ----------------------------------------------
MAX_STAKE_HARD_CAP=50.0
MIN_PAYOUT_PCT=80
MAX_CONCURRENT_ORDERS=1
DATA_DIR=../data

# --- Deriv price feed (defaults work, no account token needed) --------
DERIV_WS_URL=wss://red.derivws.com/websockets/v3
DERIV_APP_ID=1089

# --- Supabase (login + saved trades/settings) -------------------------
# IMPORTANT: if BOTH Supabase values are non-empty, login is enforced.
# Keep them empty until you really have a project and a user.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
ALLOWED_EMAIL=""

# --- Signal engine -----------------------------------------------------
ALLOW_YAHOO_FALLBACK=false
NEWS_BLACKOUT_MINUTES=15

# --- Telegram alerts (optional) ----------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_VIP_CHAT_ID=
VIP_DISPATCH_ENABLED=false
# Set a random string whenever Telegram is used.
TELEGRAM_WEBHOOK_SECRET=

# --- AI Studio preview only --------------------------------------------
# Add EMBEDDED_PREVIEW=true here ONLY after the login-cookie fix from
# Gemini-Fix-Prompt.md is in the code (the code you uploaded does not
# read this variable yet).
