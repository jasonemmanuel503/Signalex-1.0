# Pocket Option Gateway Credentials & Settings
PO_SESSION=
PO_UID=
PO_REAL_SESSION=
PO_REAL_UID=
PO_REGION=DEMO
PO_USE_FAKE_ADAPTER=false
MAX_STAKE_HARD_CAP=50.0
MIN_PAYOUT_PCT=80
MAX_CONCURRENT_ORDERS=1
DATA_DIR=data

# Deriv WebSocket Configuration
# Register your own app_id at https://developers.deriv.com
DERIV_WS_URL=wss://red.derivws.com/websockets/v3
DERIV_APP_ID=1089

# Signalex Backend & Gateways
PYTHON_BACKEND_URL=http://127.0.0.1:8001
PYTHON_BACKEND_PORT=8001
PO_GATEWAY_URL=http://127.0.0.1:8002

# Internal Security Token (shared between Next.js, python-backend, and po-gateway)
INTERNAL_API_TOKEN=dev_internal_token_signalex_2026

# Supabase Persistence & Authentication (server-only secrets; never prefix with NEXT_PUBLIC_)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
ALLOWED_EMAIL=your_email@domain.com

# Emergency Fallback (default false — degraded data never emits live signals)
ALLOW_YAHOO_FALLBACK=false

# News Blackout Period (minutes before/after high-impact news)
NEWS_BLACKOUT_MINUTES=15

# Telegram Alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_VIP_CHAT_ID=
VIP_DISPATCH_ENABLED=false
TELEGRAM_WEBHOOK_SECRET=
