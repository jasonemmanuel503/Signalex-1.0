# SIGNALEX V8.0 — Python Backend Environment Variables
# Copy to .env and fill in your values

# PRIMARY data source (real-time 1-min candles)
TWELVE_DATA_API_KEY=your_twelve_data_key_here

# Optional fallbacks
POLYGON_API_KEY=
ALPHA_VANTAGE_KEY=

# Telegram (for signal dispatch)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Telegram VIP Group (V10.0) ───────────────────────────────────────────────
# Optional. When set, ALL signals AND results are automatically sent to this
# group simultaneously with your personal chat — no manual work needed.
# See TELEGRAM_VIP_SETUP.md for step-by-step instructions.
TELEGRAM_VIP_CHAT_ID=
