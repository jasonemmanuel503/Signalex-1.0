# Pocket Option Gateway Environment Variables
PORT=8002
HOST=127.0.0.1
INTERNAL_API_TOKEN=CHANGE_ME

# Pocket Option Credentials (extracted from browser WebSocket auth payload)
# Never expose these secrets in the browser or Supabase
PO_SESSION=""
PO_UID=""

# Optional dedicated real credentials if different from demo session
PO_REAL_SESSION=""
PO_REAL_UID=""

# Broker Region (DEMO, EUROPA, UNITED_STATES_NORTH, etc.)
PO_REGION=DEMO

# Set to true to use FakePocketOptionAdapter (deterministic testing without live broker)
PO_USE_FAKE_ADAPTER=false

# Gateway Hard Guardrails (last line of defence)
MAX_STAKE_HARD_CAP=50.0
MIN_PAYOUT_PCT=80
MAX_CONCURRENT_ORDERS=1

# Local SQLite storage paths
DATA_DIR="../data"
